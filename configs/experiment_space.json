        "k": [10],
        "block_size": [8],
        "alpha": [0.5, 0.7, 0.9, 1.0],
        "beta": [1.0],
        "cpu_pinned": true
      }
    },
    "seismic": {
      "description": "SEISMIC graph-based sparse retrieval",
      "parameters": {
        "k": [10],
        "query_cut": [3, 4, 5, 8, 20],
        "heap_factor": [1.0, 1.15, 1.20, 1.30, 1.50, 1.75, 2.00],
        "n_postings": [4000],
        "centroid_fraction": [0.2],
        "summary_energy": [0.5],
        "doc_cut": [15],
        "cpu_pinned": true
      }
    }
  },
  "datasets": {
    "msmarco_splade": {
      "corpus_size": 8841823,
